# Copiar a `.env` y completar. `.env` está en .gitignore y nunca se commitea.
#
# Este archivo debe listar TODA variable que docker-compose.yml lea. Si falta
# alguna sin valor por defecto (como las de pgAdmin), un `.env` reconstruido
# desde acá levanta un stack que no arranca.

# --- Base de datos ---------------------------------------------------------
POSTGRES_DB=reservas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/reservas_db

# --- JWT y sesión ----------------------------------------------------------
# Generar con: openssl rand -hex 32
# Obligatoria: docker-compose.yml usa ${SECRET_KEY:?...} y falla sin ella.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_TIMEZONE=America/Bogota

# Controla la cabecera HSTS y el flag `Secure` de la cookie de sesión
# (backend/app/config.py, auth/auth.py, main.py).
#
# ⚠️ Poner `production` SOLO si hay TLS delante. Sobre HTTP plano rompe el
# login por completo: el navegador rechaza una cookie `Secure` en un origen
# no seguro, y el HSTS le ordena a cada visitante usar HTTPS durante dos años
# en un host que no lo tiene. Para un despliegue interno por HTTP, dejar
# `development`.
ENVIRONMENT=development

# --- Aprovisionamiento del primer administrador ----------------------------
# Las tres deben definirse juntas (password >= 12 caracteres). Una vez creada
# la cuenta se pueden retirar del entorno.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- CORS ------------------------------------------------------------------
# Solo aplica si se accede al backend directamente. En el despliegue normal el
# navegador habla únicamente con flutter_proxy (mismo origen), así que esto no
# interviene. Debe coincidir con el puerto de FLUTTER_PROXY_PORT.
BACKEND_CORS_ORIGINS=http://localhost:8091

# --- Puertos publicados en el host -----------------------------------------
# Web (Flutter servida por nginx). Se cambió de 8090 a 8091 porque en el
# servidor de despliegue el 8090 ya estaba tomado por otro proyecto.
FLUTTER_PROXY_PORT=8091

# pgAdmin. PGADMIN_BIND controla en qué interfaz se publica: 127.0.0.1
# (por defecto) lo deja accesible solo desde el propio host — para entrar
# desde otra máquina, túnel SSH. Ver el comentario en docker-compose.yml
# antes de ponerlo en 0.0.0.0.
PGADMIN_BIND=127.0.0.1
PGADMIN_HOST_PORT=8085
PGADMIN_LISTEN_PORT=5050
# Sin valor por defecto en docker-compose.yml: si faltan, pgAdmin no arranca.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# --- Nombres de volúmenes y redes ------------------------------------------
# Explícitos a propósito: los datos sobreviven aunque cambie el directorio
# del proyecto (el nombre de proyecto de compose deriva del basename).
POSTGRES_VOLUME_NAME=reservas_postgres_data
PGADMIN_VOLUME_NAME=reservas_pgadmin_data
APPLICATION_NETWORK_NAME=reservas_application_network
DATABASE_NETWORK_NAME=reservas_database_network
