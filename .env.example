# Base de datos
DATABASE_URL=postgresql://postgres:postgres@db:5432/reservas_db

# JWT
# Generar con: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_TIMEZONE=America/Bogota

# Aprovisionamiento opcional del primer administrador. Las tres variables deben
# definirse juntas. Una vez creada la cuenta, se pueden retirar del entorno.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Orígenes permitidos si se accede directamente al backend.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Destino interno del proxy /api de Next.js.
BACKEND_URL=http://backend:8000
