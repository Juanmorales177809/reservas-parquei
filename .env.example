# Copiar a `.env` y completar. `.env` está en .gitignore y nunca se commitea.
#
# Este archivo debe listar TODA variable que docker-compose.yml lea. Si falta
# alguna sin valor por defecto (como las de pgAdmin), un `.env` reconstruido
# desde acá levanta un stack que no arranca.

# --- Base de datos ---------------------------------------------------------
POSTGRES_DB=reservas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/reservas_db

# --- JWT y sesión ----------------------------------------------------------
# Generar con: openssl rand -hex 32
# Obligatoria: docker-compose.yml usa ${SECRET_KEY:?...} y falla sin ella.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_TIMEZONE=America/Bogota

# Controla la cabecera HSTS y el flag `Secure` de la cookie de sesión
# (backend/app/config.py, auth/auth.py, main.py).
#
# ⚠️ Poner `production` SOLO si hay TLS delante. Sobre HTTP plano rompe el
# login por completo: el navegador rechaza una cookie `Secure` en un origen
# no seguro, y el HSTS le ordena a cada visitante usar HTTPS durante dos años
# en un host que no lo tiene. Para un despliegue interno por HTTP, dejar
# `development`.
ENVIRONMENT=development

# --- Aprovisionamiento del primer administrador ----------------------------
# Las tres deben definirse juntas (password >= 12 caracteres). Una vez creada
# la cuenta se pueden retirar del entorno.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- CORS ------------------------------------------------------------------
# Solo aplica si se accede al backend directamente. En el despliegue normal el
# navegador habla únicamente con flutter_proxy (mismo origen), así que esto no
# interviene. Debe coincidir con el puerto de FLUTTER_PROXY_PORT.
BACKEND_CORS_ORIGINS=http://localhost:8091

# --- Puertos publicados en el host -----------------------------------------
# Web (Flutter servida por nginx). Se cambió de 8090 a 8091 porque en el
# servidor de despliegue el 8090 ya estaba tomado por otro proyecto.
FLUTTER_PROXY_PORT=8091

# pgAdmin. PGADMIN_BIND controla en qué interfaz se publica: 127.0.0.1
# (por defecto) lo deja accesible solo desde el propio host — para entrar
# desde otra máquina, túnel SSH. Ver el comentario en docker-compose.yml
# antes de ponerlo en 0.0.0.0.
PGADMIN_BIND=127.0.0.1
PGADMIN_HOST_PORT=8085
PGADMIN_LISTEN_PORT=5050
# Sin valor por defecto en docker-compose.yml: si faltan, pgAdmin no arranca.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# --- Correo saliente (app/services/email.py) -------------------------------
# Con EMAIL_ENABLED=false (default) el resto de estas variables no importa:
# el sistema sigue notificando solo in-app, sin intentar ningún envío real.
#
# En desarrollo local: levantar Mailpit (`docker compose --profile dev up -d
# mailpit`, ver el servicio `mailpit` en docker-compose.yml) y usar
#   EMAIL_ENABLED=true
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_STARTTLS=false
# Ver todo el correo enviado en http://localhost:8025 -- nunca sale de la
# máquina, así que no hay riesgo de mandarle nada a un buzón real mientras
# se prueba.
#
# En producción: credenciales reales del ITM (ver deploy/README.md y
# memoria de sesión sobre el ticket de SMTP AUTH del tenant M365).
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Puente temporal: correo por Microsoft Graph (token delegado) --------
# Mientras Sistemas del ITM entrega el App Registration con Mail.Send de
# aplicación (ver ticket-sistemas-graph-mail.html, raíz del repo), el envío
# puede pasar por Graph con una sesión delegada cacheada en disco en vez de
# SMTP. EMAIL_TRANSPORT=smtp (default) no activa nada de esto.
#
# Para usarlo: EMAIL_TRANSPORT=graph_delegado, GRAPH_MAIL_SENDER con el
# buzón que manda el correo, y correr `python -m scripts.graph_login` una
# vez (interactivo, ver backend/scripts/graph_login.py) para poblar el
# archivo de GRAPH_TOKEN_CACHE_PATH. No hace falta ningún client secret ni
# App Registration propio para este puente -- usa el cliente público
# "Microsoft Graph Command Line Tools" (el mismo que Connect-MgGraph).
EMAIL_TRANSPORT=smtp
GRAPH_MAIL_SENDER=
GRAPH_TOKEN_CACHE_PATH=/data/graph/token_cache.json

# --- Supabase Auth (único mecanismo de autenticación, corte total) ---------
# Obligatorias las tres: sin ellas `config.py::validate()` levanta
# RuntimeError al arrancar. El login clásico username/password propio
# (SECRET_KEY) se retiró por completo -- SECRET_KEY se mantiene solo por
# otros usos internos (ver backend/CLAUDE.md), no para autenticar.
# Recomendado: Cloud free tier -- crear proyecto en cloud.supabase.com y
# copiar estas vars. SUPABASE_SERVICE_ROLE_KEY es secreta (Project Settings →
# API → service role): nunca va al cliente Flutter, nunca se commitea. Ver
# backend/app/services/supabase_admin.py, backend/app/deps.py
# (_decode_token) y backend/app/api/auth.py (POST /auth/supabase/sesion).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Nombres de volúmenes y redes ------------------------------------------
# Explícitos a propósito: los datos sobreviven aunque cambie el directorio
# del proyecto (el nombre de proyecto de compose deriva del basename).
POSTGRES_VOLUME_NAME=reservas_postgres_data
PGADMIN_VOLUME_NAME=reservas_pgadmin_data
GRAPH_TOKEN_CACHE_VOLUME_NAME=reservas_graph_token_cache
APPLICATION_NETWORK_NAME=reservas_application_network
DATABASE_NETWORK_NAME=reservas_database_network
