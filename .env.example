# Copiar a .env antes de levantar nada:
#
#     cp .env.example .env
#
# .env esta en .gitignore y no se versiona: contiene credenciales.
# Guia completa de despliegue: DESPLIEGUE.md

# --- Entorno ----------------------------------------------------------------
# `desarrollo` (por defecto) acepta los valores de ejemplo. `produccion` hace que el servicio `migrar` se
# niegue a arrancar con un JWT_SECRET vacio, de ejemplo o de menos de 32 caracteres, o con la clave de
# PostgreSQL por defecto. Ponga `produccion` en el servidor.
ENTORNO=desarrollo

# --- PostgreSQL -------------------------------------------------------------
# OBLIGATORIO cambiar POSTGRES_PASSWORD en un servidor. La base NO se publica al host: se llega por
# `docker compose exec db psql -U $POSTGRES_USER $POSTGRES_DB`.
POSTGRES_DB=reservas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# En una base vacia, `migrar` carga los 5 laboratorios, 3 cargos y 2 equipos de LIA (backend/seeds/).
# Pongalo en false si quiere una base sin esos datos. En una base que ya tiene esquema no se usa.
CARGAR_DATOS_LIA=true

# --- Backend ------------------------------------------------------------
# OBLIGATORIA. Generar una propia, no reutilizar esta ni subirla a ningun repositorio:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambiar_este_secreto_por_uno_generado_localmente

# Las cookies de sesion llevan `Secure`: el navegador solo las envia por HTTPS (o por localhost). Si el
# servidor se sirve por HTTP plano, sin TLS delante, ponga false o nadie podra iniciar sesion. Con un proxy
# HTTPS delante (lo recomendado) dejelo en true.
COOKIE_SECURE=true

# El backend solo escucha en el propio servidor por defecto: el trafico publico entra por el frontend.
BACKEND_BIND=127.0.0.1
BACKEND_HOST_PORT=8000

# --- Frontend -----------------------------------------------------------------
# Puerto del servidor por el que se publica la aplicacion. Detras de un proxy HTTPS, deje 3000 y apunte el
# proxy a el; sin proxy, use 80.
FRONTEND_HOST_PORT=3000

# URL publica con la que los usuarios abren la aplicacion. Base de los enlaces de un solo uso (invitacion,
# recuperacion de contrasena): si queda en localhost, los enlaces de los correos no funcionaran.
APP_URL=http://localhost:3000

# --- Correo saliente (API-18) ---------------------------------------------------
# `log` solo registra y marca ENVIADO (desarrollo). En produccion use `smtp` y complete SMTP_*; sin correo no
# llegan las invitaciones ni la recuperacion de contrasena.
EMAIL_ENABLED=true
EMAIL_TRANSPORT=log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- pgAdmin (opcional; perfil `herramientas`) -------------------------------------
# No arranca con `docker compose up`. Solo: docker compose --profile herramientas up -d pgadmin
# Escucha unicamente en 127.0.0.1 del servidor (acceda por tunel SSH).
PGADMIN_DEFAULT_EMAIL=admin@itm.edu.co
PGADMIN_DEFAULT_PASSWORD=cambiar_esta_clave
PGADMIN_LISTEN_PORT=5050
PGADMIN_HOST_PORT=8085

# --- Nombres de volumenes y redes -------------------------------------------
# Cambiarlos crea volumenes nuevos y vacios. El volumen de PostgreSQL contiene el esquema aplicado: si lo
# cambias sin querer, parecera que la base se borro.
POSTGRES_VOLUME_NAME=reservas_postgres_data
ADJUNTOS_VOLUME_NAME=reservas_adjuntos_data
PGADMIN_VOLUME_NAME=reservas_pgadmin_data
APPLICATION_NETWORK_NAME=reservas_application_network
DATABASE_NETWORK_NAME=reservas_database_network
