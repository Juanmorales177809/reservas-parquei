# Copiar a .env antes de levantar nada:
#
#     cp .env.example .env
#
# .env esta en .gitignore y no se versiona: contiene credenciales locales.

# --- PostgreSQL -------------------------------------------------------------
# Tienen valor por defecto en docker-compose.yml, asi que `docker compose up -d db`
# funciona sin .env. Se declaran aqui para poder cambiarlas.
POSTGRES_DB=reservas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# El servicio db NO expone puerto al host, a proposito: se llega por
# `docker compose exec db psql`. Si necesitas conectarte desde una herramienta
# del host, usa pgAdmin o anade un mapeo de puertos en un override local.

# --- Backend ------------------------------------------------------------
# DB_HOST/DB_PORT no se declaran aqui: docker-compose.yml los fija a "db" y
# 5432 directamente, porque solo tienen sentido dentro de la red de Compose.
BACKEND_HOST_PORT=8000

# OBLIGATORIA para todo lo que use sesion (BK-06 en adelante): sin ella,
# security.py aborta al firmar un JWT en vez de usar un secreto predecible.
# Generar una propia, no reutilizar esta ni subirla a ningun repositorio:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambiar_este_secreto_por_uno_generado_localmente

# --- pgAdmin ----------------------------------------------------------------
# OBLIGATORIAS: no tienen valor por defecto. Sin ellas el contenedor de pgadmin
# no arranca, y `docker compose up` falla aunque la base si levante.
PGADMIN_DEFAULT_EMAIL=admin@itm.edu.co
PGADMIN_DEFAULT_PASSWORD=cambiar_esta_clave
PGADMIN_LISTEN_PORT=5050
PGADMIN_HOST_PORT=8085

# --- Nombres de volumenes y redes -------------------------------------------
# Cambiarlos crea volumenes nuevos y vacios. El volumen de PostgreSQL contiene
# el esquema aplicado: si lo cambias sin querer, parecera que la base se borro.
POSTGRES_VOLUME_NAME=reservas_postgres_data
PGADMIN_VOLUME_NAME=reservas_pgadmin_data
APPLICATION_NETWORK_NAME=reservas_application_network
DATABASE_NETWORK_NAME=reservas_database_network
